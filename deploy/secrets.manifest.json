{
  "secrets": [
    {
      "name": "step-ca-password",
      "consumers": ["step-ca"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "step-ca-provisioner-postgres-auth",
      "consumers": ["cert-bootstrap"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "step-ca-provisioner-keycloak",
      "consumers": ["cert-bootstrap"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "postgres-auth-superuser-password",
      "consumers": ["postgres-auth"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "keycloak-db-password",
      "consumers": ["postgres-auth"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "keycloak-bootstrap-admin-password",
      "consumers": ["keycloak"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "keycloak-config-client-secret",
      "consumers": ["host:keycloak-admin"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "step-ca-provisioner-forward-auth",
      "consumers": ["cert-bootstrap"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "step-ca-provisioner-whoami",
      "consumers": ["cert-bootstrap"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "forward-auth-client-secret",
      "consumers": ["forward-auth", "host:keycloak-admin"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "forward-auth-cookie-secret",
      "consumers": ["forward-auth"],
      "generator": { "type": "random", "bytes": 32 }
    },
    {
      "name": "keycloak.conf",
      "consumers": ["keycloak"],
      "derived": "db-password={keycloak-db-password}\nbootstrap-admin-password={keycloak-bootstrap-admin-password}\n"
    },
    {
      "name": "backup-login-name",
      "consumers": ["backup"],
      "entered": { "kind": "name" }
    },
    {
      "name": "backup-login-password",
      "consumers": ["backup"],
      "entered": { "kind": "password" }
    },
    {
      "name": "backup-address",
      "consumers": ["backup"],
      "entered": { "kind": "address" }
    },
    {
      "name": "backup-repository-path",
      "consumers": ["backup"],
      "entered": { "kind": "path" }
    },
    {
      "name": "backup-repository",
      "consumers": ["backup", "backup-owner", "host:backup"],
      "derived": "rest:http://{backup-login-name|url}:{backup-login-password|url}@{backup-address}/{backup-repository-path}"
    },
    {
      "name": "backup-key-password",
      "consumers": ["backup"],
      "generator": { "type": "random", "bytes": 32 }
    }
  ]
}
