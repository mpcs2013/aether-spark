# /etc/aetherspark/egress-rules.env (docs/architecture/egress.md, "Layer 3 rules"; host mode:
# docs/architecture/spark-host.md). Real values live in ops.local/; these are documentation addresses.

# Resolvers the proxies may query on port 53: the router on the Spark
AS_RESOLVERS="192.0.2.1"
# Sources allowed to open TCP 443 to Traefik: the Home subnet
AS_HOME_SUBNETS="198.51.100.0/24"
# Backup target (the NAS rest-server); leave AS_NAS_ADDR empty for no backup flow
AS_NAS_ADDR="198.51.100.20"
AS_NAS_PORT="8002"

# Host mode only (the Spark; on when /etc/aetherspark/host-mode exists). Ignored otherwise.
# The LAN interface (the 10 GbE port; its name is read at arrival)
AS_LAN_IF="lan0"
# The router: DHCP, and DNS and NTP for their service users only
AS_ROUTER="192.0.2.1"
# The admin desktop: the only source of SSH
AS_ADMIN_ADDR="198.51.100.50"
# UPS status port on AS_NAS_ADDR (given by the home-infrastructure owner); empty: no UPS flow
AS_UPS_PORT=""
# The stack collector's fixed address:port (from P3a); empty: no host telemetry flow
AS_COLLECTOR=""
AS_COLLECTOR_USER=""
# Defaults: AS_OPS_PROXY=172.30.20.2:3128 (the egress overlay), AS_RESOLVER_USER=systemd-resolve,
# AS_TIME_USER=systemd-timesync, AS_UPS_USER=nut
