{
  "_doc": "Network membership matrix and Compose rules for lint L1 (docs/architecture/egress.md, 'Network membership matrix' and 'Compose and config lint'). A change here is a design change: update the design note in the same pull request.",
  "role_label": "aetherspark.role",
  "roles": [
    "traefik", "ui-api", "keycloak", "grafana", "ntfy", "step-ca",
    "litellm", "llm-serving", "agent-host", "mcp-server", "verifier",
    "postgres", "clickhouse", "ingester", "price-job", "pipeline",
    "otel-collector", "runtime-proxy", "ops-proxy",
    "pull-job", "build-job", "taxonomy-job", "restic"
  ],
  "networks": {
    "ingress":        { "bridge": "as-ingress",     "internal": false, "roles": ["traefik"] },
    "edge":           { "bridge": "as-edge",        "internal": true,  "roles": ["traefik", "ui-api", "keycloak", "grafana", "ntfy"] },
    "auth-ingest":    { "bridge": "as-auth-ingest", "internal": true,  "roles": ["keycloak", "ingester", "price-job", "pipeline"] },
    "auth-llm":       { "bridge": "as-auth-llm",    "internal": true,  "roles": ["keycloak", "litellm", "llm-serving"] },
    "auth-agents":    { "bridge": "as-auth-agents", "internal": true,  "roles": ["keycloak", "agent-host", "mcp-server", "verifier"] },
    "auth-edge":      { "bridge": "as-auth-edge",   "internal": true,  "roles": ["keycloak", "ui-api", "grafana", "ntfy"] },
    "pki":            { "bridge": "as-pki",         "internal": true,  "roles": ["step-ca", "traefik"] },
    "llm":            { "bridge": "as-llm",         "internal": true,  "roles": ["litellm", "llm-serving", "agent-host", "pipeline"] },
    "mcp":            { "bridge": "as-mcp",         "internal": true,  "roles": ["agent-host", "mcp-server"] },
    "data-read":      { "bridge": "as-data-read",   "internal": true,  "roles": ["mcp-server", "verifier", "postgres", "clickhouse"] },
    "ingest":         { "bridge": "as-ingest",      "internal": true,  "roles": ["ingester", "price-job", "pipeline", "postgres", "clickhouse"] },
    "obs-ingest":     { "bridge": "as-obs-ingest",  "internal": true,  "roles": ["otel-collector", "ingester", "price-job", "pipeline"] },
    "obs-llm":        { "bridge": "as-obs-llm",     "internal": true,  "roles": ["otel-collector", "litellm", "llm-serving"] },
    "obs-agents":     { "bridge": "as-obs-agents",  "internal": true,  "roles": ["otel-collector", "agent-host", "mcp-server", "verifier"] },
    "obs-edge":       { "bridge": "as-obs-edge",    "internal": true,  "roles": ["otel-collector", "ui-api", "grafana", "ntfy"] },
    "egress-runtime": { "bridge": "as-eg-runtime",  "internal": true,  "roles": ["runtime-proxy", "ingester", "price-job"] },
    "out-runtime":    { "bridge": "as-out-runtime", "internal": false, "roles": ["runtime-proxy"] },
    "egress-ops":     { "bridge": "as-eg-ops",      "internal": true,  "roles": ["ops-proxy", "pull-job", "build-job", "taxonomy-job"] },
    "out-ops":        { "bridge": "as-out-ops",     "internal": false, "roles": ["ops-proxy"] },
    "backup":         { "bridge": "as-backup",      "internal": false, "roles": ["restic"] }
  },
  "never_share_a_network": [
    { "roles": ["ingester", "price-job"], "with": ["llm-serving", "mcp-server", "agent-host", "grafana"] }
  ],
  "published_ports_roles": ["traefik"],
  "model_store": { "volume": "model-store", "writers": ["pull-job"] },
  "phone_home": {
    "traefik":     { "TRAEFIK_GLOBAL_CHECKNEWVERSION": "false", "TRAEFIK_GLOBAL_SENDANONYMOUSUSAGE": "false" },
    "litellm":     { "LITELLM_LOCAL_MODEL_COST_MAP": "True", "LITELLM_TELEMETRY": "False" },
    "grafana":     { "GF_ANALYTICS_REPORTING_ENABLED": "false", "GF_ANALYTICS_CHECK_FOR_UPDATES": "false", "GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES": "false" },
    "llm-serving": { "VLLM_NO_USAGE_STATS": "1", "DO_NOT_TRACK": "1", "HF_HUB_OFFLINE": "1" }
  }
}
