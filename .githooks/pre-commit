#!/bin/sh
# Stops a commit that stages a secret (ADR-0004, ADR-0010). CI scans the full history with the
# same gitleaks version (.github/workflows/ci.yml), so a local pass means a CI pass.
set -eu

expected="8.30.1"

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks $expected not found (docs/runbooks/dev-setup.md)" >&2
    exit 1
fi
actual="$(gitleaks version)"
actual="${actual#v}"  # release images print v8.30.1, winget builds 8.30.1
if [ "$actual" != "$expected" ]; then
    echo "pre-commit: gitleaks $actual found, CI uses $expected (docs/runbooks/dev-setup.md)" >&2
    exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner .
