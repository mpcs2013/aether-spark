<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- The EDGAR ingester (docs/architecture/data-plane.md, section 3): a worker without a listener -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- The provider asks only for 10.0.x; the program and its tests use the design tools' version -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- The SEC client's own resilience pipeline (Sec/SecHttp.cs); the same version ServiceDefaults uses -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Postgresql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AetherSpark.ServiceDefaults/AetherSpark.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
