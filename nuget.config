<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Ostium's private feed (ADR-0009 amendment 1). No credential here, ever: CI passes the job's
         GITHUB_TOKEN, a local restore the owner's read-only token from the credential store, both
         as the NuGetPackageSourceCredentials_ostium variable of one process
         (docs/runbooks/ostium-packages.md) -->
    <add key="ostium" value="https://nuget.pkg.github.com/mpcs2013/index.json" />
  </packageSources>
  <!-- Ostium.* only from Ostium's feed, everything else only from nuget.org -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ostium">
      <package pattern="Ostium.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
